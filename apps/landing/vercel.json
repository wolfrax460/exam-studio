{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "https://examstudio.duckdns.org/admin" },
    { "source": "/admin/:path*", "destination": "https://examstudio.duckdns.org/admin/:path*" },
    { "source": "/app", "destination": "https://examstudio.duckdns.org/app" },
    { "source": "/app/:path*", "destination": "https://examstudio.duckdns.org/app/:path*" },
    { "source": "/assets/:path*", "destination": "https://examstudio.duckdns.org/assets/:path*" },
    { "source": "/api/:path*", "destination": "https://examstudio.duckdns.org/api/:path*" },
    { "source": "/((?!api|app|admin|assets|downloads).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
