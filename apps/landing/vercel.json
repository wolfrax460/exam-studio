{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/admin", "destination": "https://examstudio.duckdns.org/admin" },
    { "source": "/admin/:path*", "destination": "https://examstudio.duckdns.org/admin/:path*" },
    { "source": "/app", "destination": "https://examstudio.duckdns.org/app" },
    { "source": "/take/:path*", "destination": "https://examstudio.duckdns.org/take/:path*" },
    { "source": "/app/:path*", "destination": "https://examstudio.duckdns.org/app/:path*" },
    { "source": "/assets/:path*", "destination": "https://examstudio.duckdns.org/assets/:path*" },
    { "source": "/api/:path*", "destination": "https://examstudio.duckdns.org/api/:path*" },
    { "source": "/downloads/:path*", "destination": "https://examstudio.duckdns.org/downloads/:path*" },
    { "source": "/:page(docs|privacy|terms)", "destination": "/:page.html" },
    { "source": "/((?!api|app|admin|assets|downloads|images|.*\\.).+)", "destination": "/private.html" }
  ],
  "headers": [
    {
      "source": "/:area(app|admin|login|signup|account|settings|dashboard|reset-password|take|refunds)/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
