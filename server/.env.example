# Copy to .env and fill in. Never commit .env, never paste keys into chat.

# Which AI to use: anthropic, deepseek, nvidia, ollama, ollama-cloud, cli-claude,
# cli-codex, cli-opencode, cli-gemini or custom.
# Anything not set here can also be chosen later in the app's Settings screen.
AI_PROVIDER=deepseek

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# Optional: override the model. Default for DeepSeek is deepseek-flash.
# AI_MODEL=deepseek-flash

# Anthropic (billed separately from a Claude.ai plan)
ANTHROPIC_API_KEY=

PORT=3001

# Set to 1 to try the app with sample output and no API calls
DEMO_MODE=0

# Where accounts and the library are kept.
# MongoDB is used when it can be reached. If it cannot (nothing installed, wrong address),
# the app falls back to a local JSON file and keeps working - see DATA_FILE below.
MONGODB_URI=mongodb://localhost:27017/examstudio
# How long to wait for MongoDB before falling back to the file store (milliseconds).
# MONGODB_TIMEOUT_MS=3000

# The local file store, used when MongoDB is not available.
# The desktop app points this at its own user-data folder.
# DATA_FILE=./data/store.json

# JWT Authentication. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required when NODE_ENV=production. If it is empty in development, a random secret is
# generated once and saved next to the data files.
JWT_SECRET=
# Optional: how long a sign-in lasts (for example 7d, 24h, 30m).
JWT_EXPIRES_IN=7d

# Optional
GENERATE_LIMIT_PER_HOUR=30
# Handouts are the expensive one: they make one AI call per lesson plus one per unit.
# Refuse a plan bigger than this many lessons, and bigger than this many calls in total.
# HANDOUT_MAX_LESSONS=40
# HANDOUT_MAX_CALLS=120
# How many lessons are written at the same time.
# HANDOUT_CONCURRENCY=3
# How long a single request may be, in characters. 600,000 fits a whole trainee's manual.
# MAX_NOTES_CHARS=600000
# Failed sign-in attempts allowed per address per 15 minutes.
# LOGIN_LIMIT_PER_15_MIN=30

# ---- Update checks ----
# The app asks whether a newer version exists at most once every 24 hours, and caches the answer.
# Give either a GitHub repository (owner/repo, read through its releases) ...
# UPDATE_REPO=your-name/exam-studio
# ... or any URL that returns JSON with a "version" or "tag_name" (or plain text):
# UPDATE_FEED_URL=https://example.com/exam-studio/version.json
# Optional: a token, if the repository is private or you hit GitHub's anonymous rate limit.
# UPDATE_GITHUB_TOKEN=
# Where the 24-hour answer is cached. Defaults next to the settings file.
# UPDATE_FILE=./data/update-check.json
# Accounts that may be created per address per hour.
# REGISTER_LIMIT_PER_HOUR=10
# bcrypt work factor. 12 is the default; lower it only on a very slow machine.
# BCRYPT_ROUNDS=12

# Set this only when the server runs behind a reverse proxy you control (for example nginx).
# TRUST_PROXY=1
# CORS_ORIGIN=http://localhost:5173
# Allow AI settings to be changed from another computer. Off by default: settings stay
# editable only from the machine running the server.
# EXAM_STUDIO_ALLOW_REMOTE_SETTINGS=1
