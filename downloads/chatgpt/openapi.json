{
  "openapi": "3.1.0",
  "info": {
    "title": "Exam Studio API (Custom GPT Actions)",
    "version": "0.2.1",
    "description": "Trimmed OpenAPI schema for Exam Studio Custom GPT Actions. Includes generate (study notes, flashcards, exam, handout) and library endpoints only. Authentication: Bearer token (PAT es_live_... or session JWT)."
  },
  "servers": [
    { "url": "https://examstudio.duckdns.org", "description": "Exam Studio production backend" }
  ],
  "paths": {
    "/api/v1/generate/notes": {
      "post": {
        "summary": "Generate study notes from course notes",
        "description": "Turns course notes into structured study notes with topics, key points, and examples. Body text must be at least 50 characters.",
        "operationId": "generateNotes",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Course notes text (minimum 50 chars)" },
                  "title": { "type": "string", "description": "Module or notes title" },
                  "focus": { "type": "string", "description": "Optional topic to focus on" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Study notes JSON", "content": { "application/json": {} } },
          "400": { "description": "Invalid input" },
          "429": { "description": "Daily generation limit reached" },
          "502": { "description": "AI provider error" }
        }
      }
    },
    "/api/v1/generate/flashcards": {
      "post": {
        "summary": "Generate flashcards from course notes",
        "description": "Creates front/back flashcards including trap cards for commonly confused terms.",
        "operationId": "generateFlashcards",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Course notes text" },
                  "title": { "type": "string", "description": "Deck title" },
                  "count": { "type": "integer", "minimum": 5, "maximum": 80, "default": 30, "description": "Number of cards" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Flashcards JSON", "content": { "application/json": {} } },
          "400": { "description": "Invalid input" },
          "429": { "description": "Daily generation limit reached" },
          "502": { "description": "AI provider error" }
        }
      }
    },
    "/api/v1/generate/exam": {
      "post": {
        "summary": "Generate an exam paper from course notes",
        "description": "Writes an RTB-style end-of-module exam (sections A–E) with continuous numbering, plus a separate marking scheme.",
        "operationId": "generateExam",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Course notes text" },
                  "title": { "type": "string", "description": "Exam / module title" },
                  "level": { "type": "string", "description": "Level (e.g. L3, L4)" },
                  "totalMarks": { "type": "integer", "minimum": 10, "maximum": 200, "default": 100, "description": "Total marks for the paper" },
                  "types": { "type": "array", "items": { "type": "string" }, "description": "Question types: mcq, true_false, select_all, matching, sequencing, short_answer, essay" },
                  "layout": { "type": "string", "default": "sections-a-e", "description": "sections-a-e or classic" },
                  "moduleCode": { "type": "string", "description": "Module code (e.g. SWDDD401)" },
                  "trade": { "type": "string", "description": "Trade or subject area" },
                  "school": { "type": "string", "description": "School or institution" },
                  "duration": { "type": "string", "description": "Exam duration (e.g. 3 hours)" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Exam JSON with questions and marking points", "content": { "application/json": {} } },
          "400": { "description": "Invalid input" },
          "429": { "description": "Daily generation limit reached" },
          "502": { "description": "AI provider error" }
        }
      }
    },
    "/api/v1/generate/handout": {
      "post": {
        "summary": "Generate a study handout from course notes",
        "description": "Builds a full student handout: one lesson per indicative content, key terms, worked examples, diagrams, memory sheet, revision questions, practical task, and study tips.",
        "operationId": "generateHandout",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["text"],
                "properties": {
                  "text": { "type": "string", "description": "Course notes text" },
                  "title": { "type": "string", "description": "Handout / module title" },
                  "level": { "type": "string", "description": "Level (e.g. L3, L4)" },
                  "includeRevision": { "type": "boolean", "default": true, "description": "Include revision questions" },
                  "includePractical": { "type": "boolean", "default": true, "description": "Include practical assessment task" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Study handout JSON", "content": { "application/json": {} } },
          "400": { "description": "Invalid input" },
          "429": { "description": "Daily generation limit reached" },
          "502": { "description": "AI provider error" }
        }
      }
    },
    "/api/v1/library": {
      "get": {
        "summary": "List saved library items",
        "description": "Returns the user's saved notes, exams, flashcards, and handouts.",
        "operationId": "listLibrary",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Library items", "content": { "application/json": {} } } }
      },
      "post": {
        "summary": "Save an item to the library",
        "description": "Saves notes, an exam, flashcards, or a handout to the user's library.",
        "operationId": "saveLibrary",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["kind", "data"],
                "properties": {
                  "kind": { "type": "string", "enum": ["notes", "exam", "flashcards", "handout"], "description": "Item kind" },
                  "title": { "type": "string", "description": "Display title" },
                  "data": { "type": "object", "description": "Item data (the generated exam/notes/etc.)" }
                }
              }
            }
          }
        },
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Created", "content": { "application/json": {} } } }
      }
    },
    "/api/v1/library/{id}": {
      "get": {
        "summary": "Get one library item by id",
        "operationId": "getLibraryItem",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Library item", "content": { "application/json": {} } }, "404": { "description": "Not found" } }
      },
      "delete": {
        "summary": "Delete a library item by id",
        "operationId": "deleteLibraryItem",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "security": [{ "bearerAuth": [] }],
        "responses": { "204": { "description": "Deleted" }, "404": { "description": "Not found" } }
      }
    },
    "/api/v1/me/quota": {
      "get": {
        "summary": "Check user plan and daily usage",
        "description": "Returns the user's plan, requests used today/month, and tokens used today/month.",
        "operationId": "getQuota",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Plan and usage", "content": { "application/json": {} } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Personal Access Token (est_...) from Exam Studio account settings, or a session JWT from sign-in."
      }
    }
  }
}
