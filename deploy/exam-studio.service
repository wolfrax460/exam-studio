[Unit]
Description=Exam Studio API server
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=examstudio
Group=examstudio
WorkingDirectory=/opt/exam-studio
EnvironmentFile=/opt/exam-studio/.env
Environment=NODE_ENV=production
ExecStart=/opt/exam-studio/node/bin/node --max-old-space-size=192 /opt/exam-studio/server/index.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5
MemoryMax=300M
MemoryHigh=250M
CPUQuota=60%
Nice=10

[Install]
WantedBy=multi-user.target
'